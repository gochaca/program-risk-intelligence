ANTHROPIC_API_KEY=

# Optional -- only needed for weekly_cycle.py in live mode (Milestone 6).
# Leave unset to run entirely against local mock fixtures.
# JIRA_BASE_URL=https://yourcompany.atlassian.net
# JIRA_EMAIL=you@yourcompany.com
# JIRA_API_TOKEN=
# JIRA_ROSTER_JQL=resolution = Unresolved ORDER BY duedate ASC
# JIRA_INITIATIVE_FIELD=summary
# JIRA_CATEGORY_FIELD=
# JIRA_TEAM_SOURCE=label

# Optional -- caps how long the launchd scheduled jobs (Milestone 6) keep
# running. Inclusive: the end date itself still runs, only days after it
# are blocked. Once past it, a scheduled run does nothing and automatically
# uninstalls all three launchd jobs. Leave unset to run indefinitely.
# SCHEDULING_END_DATE=2026-08-14
